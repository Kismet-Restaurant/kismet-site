# Copy these into Vercel: Project > Settings > Environment Variables.
# Each form switches on once the portal ID and its own form ID are set. Until then it asks guests to email instead.
HUBSPOT_PORTAL_ID=
HUBSPOT_SIGNUP_FORM_ID=
HUBSPOT_INQUIRY_FORM_ID=

# The address the live site answers on. Used for links in search results and social previews.
NEXT_PUBLIC_SITE_URL=https://www.kismetvancouver.com
